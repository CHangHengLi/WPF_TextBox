<Page
    x:Class="TextBoxDemo.Pages.ScrollSupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TextBoxDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="滚动支持"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Wheat"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="TextBox 滚动支持" />

            <Grid Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  垂直滚动条属性  -->
                <GroupBox
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    Padding="10"
                    Header="垂直滚动条可见性 (VerticalScrollBarVisibility)">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton
                                x:Name="rbVerticalAuto"
                                Margin="0,0,15,0"
                                Checked="VerticalScrollBar_Changed"
                                Content="Auto"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="rbVerticalVisible"
                                Margin="0,0,15,0"
                                Checked="VerticalScrollBar_Changed"
                                Content="Visible" />
                            <RadioButton
                                x:Name="rbVerticalHidden"
                                Margin="0,0,15,0"
                                Checked="VerticalScrollBar_Changed"
                                Content="Hidden" />
                            <RadioButton
                                x:Name="rbVerticalDisabled"
                                Checked="VerticalScrollBar_Changed"
                                Content="Disabled" />
                        </WrapPanel>

                        <TextBlock Margin="0,0,0,5" Text="多行文本示例（垂直滚动）：" />
                        <TextBox
                            x:Name="txtVerticalScroll"
                            Height="100"
                            AcceptsReturn="True"
                            Style="{StaticResource BaseTextBoxStyle}"
                            Text="第1行文本&#x0a;第2行文本&#x0a;第3行文本&#x0a;第4行文本&#x0a;第5行文本&#x0a;第6行文本&#x0a;第7行文本&#x0a;第8行文本&#x0a;第9行文本&#x0a;第10行文本"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <TextBlock Margin="0,10,0,0" Text="说明：滚动条可见性通过RadioButton动态设置。" />
                    </StackPanel>
                </GroupBox>

                <!--  水平滚动条属性  -->
                <GroupBox
                    Grid.Row="1"
                    Margin="0,0,0,15"
                    Padding="10"
                    Header="水平滚动条可见性 (HorizontalScrollBarVisibility)">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton
                                x:Name="rbHorizontalAuto"
                                Margin="0,0,15,0"
                                Checked="HorizontalScrollBar_Changed"
                                Content="Auto"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="rbHorizontalVisible"
                                Margin="0,0,15,0"
                                Checked="HorizontalScrollBar_Changed"
                                Content="Visible" />
                            <RadioButton
                                x:Name="rbHorizontalHidden"
                                Margin="0,0,15,0"
                                Checked="HorizontalScrollBar_Changed"
                                Content="Hidden" />
                            <RadioButton
                                x:Name="rbHorizontalDisabled"
                                Checked="HorizontalScrollBar_Changed"
                                Content="Disabled" />
                        </WrapPanel>

                        <TextBlock Margin="0,0,0,5" Text="长文本示例（水平滚动）：" />

                        <!--  使用Grid替代直接使用TextBox，以更好地控制布局  -->
                        <Grid Width="300" Height="40">
                            <TextBox
                                x:Name="txtHorizontalScroll"
                                Margin="0"
                                Padding="5,5,5,5"
                                VerticalAlignment="Top"
                                Background="White"
                                BorderBrush="#AAAAAA"
                                BorderThickness="1"
                                HorizontalScrollBarVisibility="Auto"
                                Text="这是一段很长的文本内容，当文本长度超过了TextBox的宽度时，它将显示水平滚动条。这段文本足够长，可以测试水平滚动条的不同可见性设置效果。"
                                TextWrapping="NoWrap" />
                        </Grid>

                        <TextBlock Margin="0,10,0,0" Text="说明：滚动条可见性通过RadioButton动态设置。" />
                    </StackPanel>
                </GroupBox>

                <!--  文本换行与滚动  -->
                <GroupBox
                    Grid.Row="2"
                    Margin="0,0,0,15"
                    Padding="10"
                    Header="文本换行与滚动">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" Text="TextWrapping属性设置：" />
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton
                                x:Name="rbWrapWrap"
                                Margin="0,0,15,0"
                                Checked="TextWrapping_Changed"
                                Content="Wrap"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="rbWrapNoWrap"
                                Margin="0,0,15,0"
                                Checked="TextWrapping_Changed"
                                Content="NoWrap" />
                            <RadioButton
                                x:Name="rbWrapWrapWithOverflow"
                                Checked="TextWrapping_Changed"
                                Content="WrapWithOverflow" />
                        </WrapPanel>

                        <TextBlock Margin="0,0,0,5" Text="长文本示例（换行与滚动）：" />
                        <TextBox
                            x:Name="txtWrapping"
                            Width="400"
                            Height="80"
                            HorizontalScrollBarVisibility="Auto"
                            Style="{StaticResource BaseTextBoxStyle}"
                            Text="这是一段很长的文本内容，测试不同TextWrapping属性的效果。TextWrapping属性决定了文本是否应该在遇到TextBox边界时换行。Wrap表示遇到边界就换行，NoWrap表示不换行而是使用水平滚动条，WrapWithOverflow是特殊的包装模式。"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </GroupBox>

                <!--  编程控制滚动位置  -->
                <GroupBox
                    Grid.Row="3"
                    Margin="0,0,0,15"
                    Padding="10"
                    Header="编程控制滚动位置">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" Text="长文本示例（编程滚动控制）：" />
                        <TextBox
                            x:Name="txtScrollControl"
                            Height="120"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            Style="{StaticResource BaseTextBoxStyle}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Visible" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                Margin="0,0,5,0"
                                Click="AddLines_Click"
                                Content="添加10行文本" />
                            <Button
                                Margin="0,0,5,0"
                                Click="ScrollToHome_Click"
                                Content="滚动到顶部" />
                            <Button
                                Margin="0,0,5,0"
                                Click="ScrollToEnd_Click"
                                Content="滚动到底部" />
                            <Button Click="ScrollToLine5_Click" Content="滚动到第5行" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!--  说明信息  -->
            <Border
                Margin="0,20,0,0"
                Padding="10"
                Background="#F5F5F5"
                BorderBrush="LightGray"
                BorderThickness="1">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold">TextBox 滚动支持属性说明:</Run>
                    <LineBreak />
                    <Run>• VerticalScrollBarVisibility: 控制垂直滚动条的显示方式</Run>
                    <LineBreak />
                    <Run>• HorizontalScrollBarVisibility: 控制水平滚动条的显示方式</Run>
                    <LineBreak />
                    <Run>• TextWrapping: 控制文本是否换行</Run>
                    <LineBreak />
                    <Run>• ScrollToHome(): 滚动到文档开始</Run>
                    <LineBreak />
                    <Run>• ScrollToEnd(): 滚动到文档结尾</Run>
                    <LineBreak />
                    <Run>• ScrollToVerticalOffset(offset): 滚动到指定的垂直偏移位置</Run>
                    <LineBreak />
                    <Run>• ScrollToHorizontalOffset(offset): 滚动到指定的水平偏移位置</Run>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 