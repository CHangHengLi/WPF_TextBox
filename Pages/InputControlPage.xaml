<Page
    x:Class="TextBoxDemo.Pages.InputControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TextBoxDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="输入控制"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Wheat"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="TextBox 输入控制" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  MaxLength 属性  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="MaxLength 属性:" />
                <TextBox
                    x:Name="MaxLengthDemo"
                    Grid.Row="0"
                    Grid.Column="1"
                    MaxLength="10"
                    Style="{StaticResource BaseTextBoxStyle}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="最多输入10个字符" />

                <!--  CharacterCasing 属性  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="CharacterCasing 属性:" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    CharacterCasing="Upper"
                    Style="{StaticResource BaseTextBoxStyle}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="自动转为大写" />

                <!--  AcceptsReturn 属性  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="AcceptsReturn 属性:" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="60"
                    Margin="0,10,0,0"
                    AcceptsReturn="True"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="按回车键可以换行&#x0a;这是第二行"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="支持回车换行" />

                <!--  AcceptsTab 属性  -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="AcceptsTab 属性:" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Height="60"
                    Margin="0,10,0,0"
                    AcceptsTab="True"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="可以使用Tab键&#x09;这是Tab后的文本"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="支持Tab缩进" />

                <!--  IsUndoEnabled 属性  -->
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="IsUndoEnabled 属性:" />
                <TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="默认支持撤销操作" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="可使用Ctrl+Z撤销" />

                <!--  IsUndoEnabled=False  -->
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="禁用撤销功能:" />
                <TextBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    IsUndoEnabled="False"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="不支持撤销操作" />
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="Ctrl+Z无效" />
            </Grid>

            <!--  说明信息  -->
            <Border
                Margin="0,20,0,0"
                Padding="10"
                Background="#F5F5F5"
                BorderBrush="LightGray"
                BorderThickness="1">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold">TextBox 输入控制属性说明:</Run>
                    <LineBreak />
                    <Run>• MaxLength: 限制可输入的最大字符数</Run>
                    <LineBreak />
                    <Run>• CharacterCasing: 控制输入文本的大小写形式(Upper, Lower, Normal)</Run>
                    <LineBreak />
                    <Run>• AcceptsReturn: 设置是否接受回车键输入来创建新行</Run>
                    <LineBreak />
                    <Run>• AcceptsTab: 设置是否接受Tab键输入来创建制表符</Run>
                    <LineBreak />
                    <Run>• IsUndoEnabled: 启用或禁用撤销操作功能</Run>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 