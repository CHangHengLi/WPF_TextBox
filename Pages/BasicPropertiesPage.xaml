<Page
    x:Class="TextBoxDemo.Pages.BasicPropertiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TextBoxDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="基本属性"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Wheat"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="TextBox 基本属性演示" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Text 属性  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Text 属性:" />
                <TextBox
                    x:Name="TextPropertyDemo"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="这是Text属性的初始值" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Text, ElementName=TextPropertyDemo}" />

                <!--  FontSize 属性  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="FontSize 属性:" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    FontSize="16"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="可以设置不同的字体大小" />
                <Slider
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="100"
                    Margin="10,10,0,0"
                    IsEnabled="False"
                    Maximum="24"
                    Minimum="8"
                    Value="16" />

                <!--  FontWeight 属性  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="FontWeight 属性:" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    FontWeight="Bold"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="可以设置字体粗细" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="Bold" />

                <!--  Foreground 属性  -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="Foreground 属性:" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    Foreground="Blue"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="可以设置前景色" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="Blue" />

                <!--  Background 属性  -->
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="Background 属性:" />
                <TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    Background="LightYellow"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="可以设置背景色" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="LightYellow" />

                <!--  IsReadOnly 属性  -->
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="0,10,10,0"
                    VerticalAlignment="Center"
                    Text="IsReadOnly 属性:" />
                <TextBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    IsReadOnly="True"
                    Style="{StaticResource BaseTextBoxStyle}"
                    Text="这是一个只读的TextBox" />
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="2"
                    Margin="10,10,0,0"
                    VerticalAlignment="Center"
                    Text="True" />
            </Grid>

            <!--  说明信息  -->
            <Border
                Margin="0,20,0,0"
                Padding="10"
                Background="#F5F5F5"
                BorderBrush="LightGray"
                BorderThickness="1">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="Bold">TextBox 基本属性说明:</Run>
                    <LineBreak />
                    <Run>• Text: 获取或设置文本框中的文本内容</Run>
                    <LineBreak />
                    <Run>• FontSize: 设置文本的字体大小</Run>
                    <LineBreak />
                    <Run>• FontWeight: 设置文本的字体粗细</Run>
                    <LineBreak />
                    <Run>• Foreground: 设置文本的前景色</Run>
                    <LineBreak />
                    <Run>• Background: 设置文本框的背景色</Run>
                    <LineBreak />
                    <Run>• IsReadOnly: 设置文本框是否为只读状态</Run>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 