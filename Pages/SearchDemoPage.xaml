<Page x:Class="TextBoxDemo.Pages.SearchDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TextBoxDemo.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Wheat"
      Title="实时搜索示例">
    
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="实时搜索示例" />
            
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        在下方输入框中输入内容，实时过滤水果列表
                    </TextBlock>
                    
                    <TextBox x:Name="txtSearch" 
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" 
                         Margin="0,0,0,10"
                         Padding="5"
                         Style="{StaticResource BaseTextBoxStyle}"/>
                    
                    <ListBox x:Name="resultsList"
                             ItemsSource="{Binding FilteredItems}"
                             Height="300"
                             Width="200"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 