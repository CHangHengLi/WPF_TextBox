<Page
    x:Class="TextBoxDemo.Pages.StylesTemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TextBoxDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="样式与模板"
    d:DesignHeight="1450"
    d:DesignWidth="800"
    Background="Wheat"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  基本样式  -->
        <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#3498db" />
            <Setter Property="Background" Value="#ecf0f1" />
            <Setter Property="Foreground" Value="#2c3e50" />
        </Style>

        <!--  错误样式  -->
        <Style
            x:Key="ErrorTextBoxStyle"
            BasedOn="{StaticResource CustomTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#e74c3c" />
            <Setter Property="Background" Value="#fadbd8" />
            <Setter Property="ToolTip" Value="输入有误" />
        </Style>

        <!--  成功样式  -->
        <Style
            x:Key="SuccessTextBoxStyle"
            BasedOn="{StaticResource CustomTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#2ecc71" />
            <Setter Property="Background" Value="#d5f5e3" />
            <Setter Property="ToolTip" Value="输入正确" />
        </Style>

        <!--  触发器样式  -->
        <Style
            x:Key="TriggerTextBoxStyle"
            BasedOn="{StaticResource CustomTextBoxStyle}"
            TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#9b59b6" />
                    <Setter Property="Background" Value="#e8daef" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="#f39c12" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#bdc3c7" />
                    <Setter Property="Foreground" Value="#7f8c8d" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  圆角样式  -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Padding="2"
                            Background="#ecf0f1"
                            BorderBrush="#3498db"
                            BorderThickness="2"
                            CornerRadius="8">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="5,2"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#9b59b6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Height" Value="40" />
        </Style>

        <!--  搜索框样式  -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border
                                Padding="2"
                                Background="White"
                                BorderBrush="#bdc3c7"
                                BorderThickness="1"
                                CornerRadius="20">
                                <Grid>
                                    <ScrollViewer
                                        x:Name="PART_ContentHost"
                                        Margin="12,4,30,4"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="PlaceholderText"
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#bdc3c7"
                                        Text="搜索..."
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        Margin="0,0,10,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="#7f8c8d"
                                        Text="🔍" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3498db" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Height" Value="40" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="TextBox 样式与模板" />

            <!--  样式基础介绍  -->
            <Border
                Margin="0,0,0,20"
                Padding="15"
                Background="#f9f9f9"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        <Run FontWeight="Bold">样式与模板</Run>
                        是WPF中强大的功能，通过样式可以设置控件的外观，通过模板可以完全自定义控件的视觉结构。</TextBlock>
                </StackPanel>
            </Border>

            <!--  基本样式  -->
            <TextBlock
                Margin="0,10"
                FontSize="18"
                FontWeight="Bold"
                Text="1. 基本样式" />
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                使用Style设置TextBox的基本样式，如字体、颜色、边框等。
            </TextBlock>
            <TextBox
                Width="400"
                HorizontalAlignment="Left"
                Style="{StaticResource CustomTextBoxStyle}"
                Text="这是一个应用了基本样式的TextBox" />

            <!--  条件样式  -->
            <TextBlock
                Margin="0,20,0,10"
                FontSize="18"
                FontWeight="Bold"
                Text="2. 条件样式" />
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                根据不同条件应用不同的样式，如错误状态、成功状态等。
            </TextBlock>
            <TextBox
                Width="400"
                HorizontalAlignment="Left"
                Style="{StaticResource ErrorTextBoxStyle}"
                Text="错误状态" />
            <TextBox
                Width="400"
                HorizontalAlignment="Left"
                Style="{StaticResource SuccessTextBoxStyle}"
                Text="成功状态" />

            <!--  触发器样式  -->
            <TextBlock
                Margin="0,20,0,10"
                FontSize="18"
                FontWeight="Bold"
                Text="3. 触发器样式" />
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                使用触发器在不同状态下改变控件样式，如鼠标悬停、获得焦点等。
            </TextBlock>
            <TextBox
                Width="400"
                HorizontalAlignment="Left"
                Style="{StaticResource TriggerTextBoxStyle}"
                Text="将鼠标移至此处或点击此处" />
            <TextBox
                Width="400"
                HorizontalAlignment="Left"
                IsEnabled="False"
                Style="{StaticResource TriggerTextBoxStyle}"
                Text="此TextBox已禁用" />

            <!--  控件模板  -->
            <TextBlock
                Margin="0,20,0,10"
                FontSize="18"
                FontWeight="Bold"
                Text="4. 控件模板" />
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                通过ControlTemplate完全自定义TextBox的外观，如圆角、特殊背景等。
            </TextBlock>
            <TextBox
                Width="400"
                HorizontalAlignment="Left"
                Style="{StaticResource RoundedTextBoxStyle}"
                Text="圆角TextBox" />

            <!--  搜索框模板  -->
            <TextBlock
                Margin="0,20,0,10"
                FontSize="18"
                FontWeight="Bold"
                Text="5. 高级模板样例 - 搜索框" />
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                复杂的控件模板，自定义搜索框外观，包含占位符文本和Unicode搜索图标。
            </TextBlock>
            <TextBox
                Width="400"
                HorizontalAlignment="Left"
                Style="{StaticResource SearchTextBoxStyle}" />

            <!--  全局样式说明  -->
            <TextBlock
                Margin="0,20,0,10"
                FontSize="18"
                FontWeight="Bold"
                Text="6. 应用全局样式" />
            <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                要将样式应用到整个应用程序的所有TextBox，可以在App.xaml中定义全局样式，无需显式引用样式。方法是定义不带x:Key的样式：<LineBreak /><LineBreak />
                <Run FontFamily="Consolas">
                    &lt;Style TargetType="TextBox"&gt;
                    &lt;Setter Property="FontFamily" Value="Microsoft YaHei"/&gt;
                    ...其他设置...
                    &lt;/Style&gt;
                </Run>
            </TextBlock>

            <!--  样式继承说明  -->
            <Border
                Margin="0,0,0,20"
                Padding="15"
                Background="#e8f4f8"
                BorderBrush="#bce8f1"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="Bold" TextWrapping="Wrap">
                        提示：样式与模板的优势
                    </TextBlock>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                        1. 集中管理UI - 在一处定义样式，多处使用<LineBreak />
                        2. 一致性 - 确保应用中所有TextBox具有一致的外观<LineBreak />
                        3. 易于维护 - 修改样式时只需更改一处，所有引用该样式的控件都会更新<LineBreak />
                        4. 分离外观与功能 - 使代码更清晰，逻辑与外观分离</TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 