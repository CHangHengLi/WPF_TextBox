<Window
    x:Class="TextBoxDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TextBoxDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TextBox控件详解演示"
    Width="1000"
    Height="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2c3e50">
            <TextBlock
                Margin="15,10"
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="TextBox控件详解演示" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧导航菜单  -->
            <Border
                Background="#f5f5f5"
                BorderBrush="#ddd"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="BasicProperties_Click"
                            Content="基本属性与功能" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="InputControl_Click"
                            Content="输入控制" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="TextSelection_Click"
                            Content="文本选择与操作" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="ScrollSupport_Click"
                            Content="滚动支持" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="DataValidation_Click"
                            Content="数据验证" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="UndoRedo_Click"
                            Content="撤销/重做支持" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="DataBinding_Click"
                            Content="文本绑定" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="StylesTemplates_Click"
                            Content="样式与模板" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="Applications_Click"
                            Content="应用场景示例" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="SearchDemo_Click"
                            Content="实时搜索示例" />
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="SpecialTextBox_Click"
                            Content="特殊文本框示例" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  右侧内容区域  -->
            <Frame
                x:Name="MainContent"
                Grid.Column="1"
                NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Window> 